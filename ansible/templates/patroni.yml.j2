scope: pgcluster
namespace: /service/
name: {{ inventory_hostname }}

restapi:
  listen: 0.0.0.0:8008
  connect_address: {{ ansible_host }}:8008

etcd3:
  hosts: {{ hostvars['etcd01'].ansible_host }}:2379

bootstrap:
  dcs:
    ttl: 30
    loop_wait: 10
    retry_timeout: 10
    maximum_lag_on_failover: 1048576
    postgresql:
      use_pg_rewind: true
      parameters:
        wal_level: replica
        hot_standby: "on"
        wal_log_hints: "on"
        max_wal_senders: 10
        max_replication_slots: 10
        shared_preload_libraries: pg_stat_statements
        pg_stat_statements.track: all
  initdb:
    - encoding: UTF8
    - data-checksums

postgresql:
  listen: 0.0.0.0:5432
  connect_address: {{ ansible_host }}:5432
  data_dir: {{ pg_data_dir }}
  bin_dir: {{ pg_bin_dir }}
  pgpass: /var/lib/pgsql/.pgpass_patroni
  basebackup:
    checkpoint: fast
  authentication:
    superuser:
      username: postgres
      password: "{{ pg_superuser_password }}"
    replication:
      username: replicator
      password: "{{ pg_replication_password }}"
  pg_hba:
    - local   all          all                        peer
    - host    all          all          127.0.0.1/32      scram-sha-256
    - host    replication  replicator   192.168.56.0/24   scram-sha-256
    - host    all          all          192.168.56.0/24   scram-sha-256
    - host    all          all          192.168.121.0/24  scram-sha-256
